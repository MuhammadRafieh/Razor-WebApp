## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2017/2019 auto-generated files
Generated\ Files/

# MSTest test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadme.txt

# StyleCop
StyleCopReport.xml

# Build output of an ASP.NET Core app
publish/

# NuGet
*.nupkg
*.snupkg
#[Nn]uget/
#[Nn]uget.targets/
*.nupkg.cache

# The bin, obj, and publish folders produced by this project
**/bin/
**/obj/
**/publish/

# dotnet cache
.ide/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio code cache
.vs/

